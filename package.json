{
  "name": "mongobot",
  "version": "0.2.0",
  "description": "In-database observability for MongoDB. One read-only CLI reads MongoDB's own counters and prints a findings-first health report — plus what changed since last time. Optional Atlas layer adds host metrics and Performance Advisor.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierHamelyn/mongobot.git"
  },
  "keywords": [
    "mongodb",
    "atlas",
    "observability",
    "monitoring",
    "performance",
    "queryStats",
    "indexes",
    "cli"
  ],
  "bin": { "mongobot": "./dist/mongobot.mjs" },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "bun build src/cli.ts --target=node --outfile=dist/mongobot.mjs && chmod +x dist/mongobot.mjs",
    "test": "node --test test/*.test.ts"
  },
  "engines": { "node": ">=22.18" },
  "dependencies": {
    "mongodb": "^7.5.0"
  }
}
